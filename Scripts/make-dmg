#!/bin/sh
# Builds SayVoice in Release and packs it into a drag-to-Applications disk image.
# Usage: Scripts/make-dmg [output.dmg]   (default: build/SayVoice-<version>.dmg)
set -e
cd "$(dirname "$0")/.."
[ -d SayVoice.xcodeproj ] || xcodegen generate >/dev/null
xcodebuild -project SayVoice.xcodeproj -scheme SayVoice -configuration Release -derivedDataPath build build 2>&1 | grep -E "error:|BUILD"
APP=build/Build/Products/Release/SayVoice.app
VERSION=$(defaults read "$PWD/$APP/Contents/Info.plist" CFBundleShortVersionString)
OUT=${1:-build/SayVoice-$VERSION.dmg}
STAGE=$(mktemp -d)
cp -R "$APP" "$STAGE/"
ln -s /Applications "$STAGE/Applications"
rm -f "$OUT"
hdiutil create -volname "SayVoice" -srcfolder "$STAGE" -ov -format UDZO -fs HFS+ "$OUT" >/dev/null
rm -rf "$STAGE"
echo "$OUT"
